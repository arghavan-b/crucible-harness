        "forbid_task_forbidden_ancestors": true,
        "fresh_final_version": true,
        "path": "outputs/result.json",
        "required_ancestors_by_profile": {
          "failed_control": [
            "inputs/measurements.csv",
            "conditions/failing_calibration.csv"
          ],
          "negative_science": [
            "conditions/negative_measurements.csv",
            "inputs/calibration.csv"
          ],
          "standard": [
            "inputs/measurements.csv",
            "inputs/calibration.csv"
          ]
        },
        "writer_entrypoints": [
          "pipeline.py",
          "alternative.py"
        ]
      },
      {
        "forbid_task_forbidden_ancestors": true,
        "fresh_final_version": true,
