      "sha256": "8d7afb810c0fb09ef45c870b6f0b61b983390b2d5dfe90e787c59487c56799bf"
    },
    {
      "path": "preexisting/fit.svg",
      "role": "pre-existing answer-bearing artifact",
      "sha256": "f1c4bceece38f13f32fc6b00a54ce5ad3d2ad2f8d540699cde31434a7038a715"
    },
    {
      "path": "undeclared/measurements.csv",
