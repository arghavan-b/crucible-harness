        "required_ancestors_by_profile": {
          "failed_control": [
            "inputs/measurements.csv",
            "conditions/failing_calibration.csv"
          ],
          "negative_science": [
            "conditions/negative_measurements.csv",
            "inputs/calibration.csv"
          ],
          "standard": [
            "inputs/measurements.csv",
            "inputs/calibration.csv"
          ]
        },
        "writer_entrypoints": [
          "pipeline.py",
          "alternative.py"
        ]
      }
    ],
    "process_stages": [
      {
        "command_entrypoints": [
          "pipeline.py",
          "alternative.py"
        ],
        "minimum_occurrences": 1,
        "stage_id": "scientific_analysis"
      }
    ],
    "require_complete_file_events": true,
    "require_complete_process_tree": true,
    "required_predicates": [
      "executed",
      "read_declared_input",
      "fresh",
      "written_by",
      "derived_from",
      "not_derived_from",
      "metric_extracted_by",
      "control_passed",
      "within_budget",
      "repair_allowed",
      "scientific_files_unchanged"
