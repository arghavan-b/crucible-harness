          "failed_control": [
            "inputs/measurements.csv",
            "conditions/failing_calibration.csv"
          ],
          "negative_science": [
            "conditions/negative_measurements.csv",
            "inputs/calibration.csv"
          ],
          "standard": [
            "inputs/measurements.csv",
            "inputs/calibration.csv"
          ]
        },
        "writer_entrypoints": [
          "summarize.py"
        ]
      }
    ],
    "process_stages": [
