    },
    "literal_fields": {
      "schema_version": 1
    },
    "numeric_fields": [
      "geometric_mean_growth",
      "calibration_max_abs_error"
    ],
    "task_id": "confirm_geometric_growth"
  },
  "runtime": {
    "monitor_platform": "linux",
