{
  "allowed_repairs": [
    {
      "allowed_paths": [
        "outputs",
        "work"
      ],
      "command": [
        "{python}",
        "-c",
        "from pathlib import Path; import subprocess,sys; Path('outputs').mkdir(parents=True,exist_ok=True); Path('work').mkdir(parents=True,exist_ok=True); subprocess.run([sys.executable,'run_pipeline.py'],check=True)"
      ],
      "description": "Create only missing runtime output directories before the required pipeline.",
      "kind": "environment",
      "repair_id": "create_runtime_directories"
    }
  ],
  "allowed_scientific_variants": [
    {
      "command": [
        "{python}",
        "run_alternative.py"
      ],
      "description": "Use the frozen equivalent implementation or preparation ordering.",
      "variant_id": "equivalent_ordering"
    }
  ],
  "condition_commands": {
    "failed_control": [
      "{python}",
      "run_pipeline.py",
      "--calibration",
      "conditions/failing_calibration.csv"
    ],
    "negative_science": [
      "{python}",
      "run_pipeline.py",
      "--data",
      "conditions/negative_measurements.csv"
    ]
  },
  "condition_inputs": {
    "failed_control": [
