        "stage_id": "pipeline_runner"
      },
      {
        "command_entrypoints": [
          "prepare.py",
          "prepare_alternative.py"
        ],
        "minimum_occurrences": 1,
        "stage_id": "preparation"
      },
      {
        "command_entrypoints": [
          "summarize.py"
        ],
        "minimum_occurrences": 1,
        "stage_id": "summarization"
      }
