{
  "allowed_repairs": [
    {
      "allowed_paths": [
        "outputs"
      ],
      "command": [
        "{python}",
        "-c",
        "from pathlib import Path; import subprocess,sys; Path('outputs').mkdir(parents=True,exist_ok=True); subprocess.run([sys.executable,'pipeline.py'],check=True)"
      ],
      "description": "Create only missing runtime output directories before the required pipeline.",
      "kind": "environment",
      "repair_id": "create_runtime_directories"
    }
  ],
  "allowed_scientific_variants": [
    {
      "command": [
        "{python}",
        "alternative.py"
      ],
      "description": "Use the frozen equivalent implementation or preparation ordering.",
      "variant_id": "equivalent_ordering"
    }
  ],
  "condition_commands": {
    "failed_control": [
      "{python}",
      "pipeline.py",
      "--calibration",
      "conditions/failing_calibration.csv"
    ],
    "negative_science": [
      "{python}",
      "pipeline.py",
      "--data",
      "conditions/negative_measurements.csv"
    ]
  },
  "condition_inputs": {
    "failed_control": [
      {
        "path": "conditions/failing_calibration.csv",
        "role": "declared failed-control input",
        "sha256": "4f464e3fae7bd6909d910e6d2c9a119122b147777e372cc6f47a5883943f2a4c"
      }
    ],
    "negative_science": [
      {
        "path": "conditions/negative_measurements.csv",
        "role": "declared negative-result input",
        "sha256": "a4249542a19c18522c8527fa83e9134ac14ba1ae30844911899fcb5587dbad1f"
      }
    ]
  },
  "declared_inputs": [
    {
      "path": "inputs/measurements.csv",
      "role": "primary scientific input",
      "sha256": "a5bdc971cceb648ab6cd544f5a0dc65ef5bd7060fdb2b43877941fb5301a1d57"
    },
    {
      "path": "inputs/calibration.csv",
      "role": "positive-control input",
      "sha256": "fb6666fdd244da05bf060509127b466d47304ef2c73da9eb97d41c626ab59ef6"
    },
    {
      "path": "inputs/query.sql",
      "role": "declared SQL analysis",
      "sha256": "ca3dc4fa75f4a1c694d9a7f260d69f69433bf04a376b65402059e667f51cdca5"
    }
  ],
  "description": "Load measurements into SQLite and execute a declared aggregate query.",
  "evaluation_role": "confirmatory",
  "family": "sqlite-query",
  "forbidden_ancestors": [
    {
      "path": "preexisting/result.json",
      "role": "pre-existing answer-bearing artifact",
      "sha256": "2f6ca33e0b71ae82b0629e5a08f3cd06abc1823fef55c14cc0cef98a0a991c0c"
    },
    {
      "path": "preexisting/summary.csv",
      "role": "pre-existing answer-bearing artifact",
      "sha256": "ee375c76a28d971c015f372e2e75e820c21828f62075dd356e77ba7029fdcfbf"
    },
    {
      "path": "undeclared/measurements.csv",
      "role": "undeclared alternate scientific input",
      "sha256": "a5bdc971cceb648ab6cd544f5a0dc65ef5bd7060fdb2b43877941fb5301a1d57"
    }
  ],
  "measurement": {
    "artifact_path": "outputs/result.json",
    "extractor_id": "controlled-json-v1",
    "metric": "threshold_rate",
    "operator": ">=",
    "threshold": 0.7,
    "tolerance": 0.0
  },
  "positive_control": {
    "artifact_path": "outputs/result.json",
    "expected": 0.0,
    "extractor_id": "controlled-json-v1",
    "metric": "calibration_max_abs_error",
    "reported_pass_field": "positive_control_passed",
    "tolerance": 0.0
  },
  "provenance": {
    "final_version_policy": "last_observed_write_episode",
    "input_profiles": {
      "failed_control": {
        "required_ancestors": [
          "inputs/measurements.csv",
          "conditions/failing_calibration.csv",
          "inputs/query.sql"
        ]
      },
      "negative_science": {
        "required_ancestors": [
          "conditions/negative_measurements.csv",
          "inputs/calibration.csv",
          "inputs/query.sql"
        ]
      },
      "standard": {
        "required_ancestors": [
          "inputs/measurements.csv",
          "inputs/calibration.csv",
          "inputs/query.sql"
        ]
      }
    },
    "intermediate_artifacts": [],
    "monitor_profile": "crucible-linux-strace-v1",
    "network_policy": "none",
    "output_lineage": [
      {
        "forbid_task_forbidden_ancestors": true,
        "fresh_final_version": true,
        "path": "outputs/result.json",
        "required_ancestors_by_profile": {
          "failed_control": [
            "inputs/measurements.csv",
            "conditions/failing_calibration.csv",
            "inputs/query.sql"
          ],
          "negative_science": [
            "conditions/negative_measurements.csv",
            "inputs/calibration.csv",
            "inputs/query.sql"
          ],
          "standard": [
            "inputs/measurements.csv",
            "inputs/calibration.csv",
            "inputs/query.sql"
          ]
        },
        "writer_entrypoints": [
          "pipeline.py",
          "alternative.py"
        ]
      },
      {
        "forbid_task_forbidden_ancestors": true,
        "fresh_final_version": true,
        "path": "outputs/summary.csv",
        "required_ancestors_by_profile": {
          "failed_control": [
            "inputs/measurements.csv",
            "conditions/failing_calibration.csv",
            "inputs/query.sql"
          ],
          "negative_science": [
            "conditions/negative_measurements.csv",
            "inputs/calibration.csv",
            "inputs/query.sql"
          ],
          "standard": [
            "inputs/measurements.csv",
            "inputs/calibration.csv",
            "inputs/query.sql"
          ]
        },
        "writer_entrypoints": [
          "pipeline.py",
          "alternative.py"
        ]
      }
    ],
    "process_stages": [
      {
        "command_entrypoints": [
          "pipeline.py",
          "alternative.py"
        ],
        "minimum_occurrences": 1,
        "stage_id": "scientific_analysis"
      }
    ],
    "require_complete_file_events": true,
    "require_complete_process_tree": true,
    "required_predicates": [
      "executed",
      "read_declared_input",
      "fresh",
      "written_by",
      "derived_from",
      "not_derived_from",
      "metric_extracted_by",
      "control_passed",
      "within_budget",
      "repair_allowed",
      "scientific_files_unchanged"
    ],
    "schema_version": 1,
    "trusted_extraction": {
      "artifact_path": "outputs/result.json",
      "bind_to_final_version": true,
      "extractor_id": "controlled-json-v1"
    }
  },
  "required_command": [
    "{python}",
    "pipeline.py"
  ],
  "required_outputs": [
    {
      "media_type": "application/json",
      "path": "outputs/result.json"
    },
    {
      "csv_columns": [
        "metric",
        "value"
      ],
      "csv_key_column": "metric",
      "media_type": "text/csv",
      "mirrors_result_fields": [
        "calibration_max_abs_error",
        "n_records",
        "positive_control_passed",
        "schema_version",
        "threshold_rate"
      ],
      "path": "outputs/summary.csv"
    }
  ],
  "result_schema": {
    "allow_additional_fields": false,
    "boolean_fields": [
      "positive_control_passed"
    ],
    "integer_fields": {
      "n_records": 4
    },
    "literal_fields": {
      "schema_version": 1
    },
    "numeric_fields": [
      "threshold_rate",
      "calibration_max_abs_error"
    ],
    "task_id": "confirm_sql_threshold_rate"
  },
  "runtime": {
    "monitor_platform": "linux",
    "network": "none",
    "python": ">=3.12",
    "timeout_s": 30
  },
  "schema_version": 3,
  "task_id": "confirm_sql_threshold_rate"
}
